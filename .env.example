# Flask Configuration
FLASK_SECRET_KEY=change-this-in-production-super-secret-key
FLASK_ENV=development

# Database Configuration
DATABASE_PATH=multicloud_storage.db

# AWS S3 Settings
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-aws-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Scaleway Object Storage Settings
SCW_ACCESS_KEY=your-scaleway-access-key-id
SCW_SECRET_KEY=your-scaleway-secret-key
SCW_REGION=fr-par
SCW_BUCKET_NAME=your-scaleway-bucket-name
SCW_ENDPOINT_URL=https://s3.fr-par.scw.cloud

# Oracle Cloud Infrastructure (OCI) Object Storage Settings
OCI_ACCESS_KEY=your-oci-access-key-id
OCI_SECRET_KEY=your-oci-secret-key
OCI_REGION=ap-hyderabad-1
OCI_NAMESPACE=your-oci-tenancy-namespace
OCI_BUCKET_NAME=your-oci-bucket-name

# Single Owner / Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass
